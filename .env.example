# Copy to .env and fill in. .env is git-ignored; never commit a real token.
#
# There are three stacks, one per compose file, each deployable on its own machine:
#
#   compose.biobank.yml     biobank-db, biobank-api        needs the patient XML export
#   compose.sequencing.yml  sequencing-db, sequencing-api  needs the organised run tree
#   compose.uploader.yml    uploader-db, uploader          needs no files at all
#
# Put this same file on every machine and fill in the sections that machine runs; leave the rest.
# Docker Compose reads it twice over: once to substitute ${VARIABLES} in the compose file, and
# again to hand the values to the uploader container.
#
# See docs/deployment.md for the full runbook.


# =============================================================================
# BIOBANK STACK  (compose.biobank.yml)
# =============================================================================

# The interface the biobank API listens on. This API has NO authentication and /patients serves
# real patient identifiers, so this must be an address only the uploader's machine can reach —
# never 0.0.0.0 and never a public one. Loopback is right when the uploader runs on this host.
BIOBANK_BIND=127.0.0.1

# Where the patient XML export lives on this machine.
BIOBANK_XML_EXPORT_DIR=/home/mou/patient_data


# =============================================================================
# SEQUENCING STACK  (compose.sequencing.yml)
# =============================================================================

# Same rule as BIOBANK_BIND: loopback if the uploader runs on this host, a private address both
# machines can see if it does not.
SEQUENCING_BIND=127.0.0.1

# The three read-only source trees on this machine.
SEQUENCING_RUNS_DIR=/muni-sc/OrganisedRuns
SEQUENCING_LIBRARIES_DIR=/muni-sc/Libraries
SEQUENCING_MAPPING_DIR=/home/export/pseudonymization_table


# =============================================================================
# UPLOADER STACK  (compose.uploader.yml)
# =============================================================================

# Where the two source APIs are, as seen from inside the uploader container. Both are required: an
# empty value means "this source is not deployed", so a blank would upload nobody without
# complaining. Compose refuses to start rather than let that happen.
#
#   source stack on this same machine  ->  http://host.docker.internal:8001
#   source stack on another machine    ->  http://<that machine's BIOBANK_BIND>:8001
#
# host.docker.internal is needed even on one host, because the three stacks are three separate
# Compose projects on three separate networks, so container names do not resolve between them.
BIOBANK_API_URL=http://host.docker.internal:8001
SEQUENCING_API_URL=http://host.docker.internal:8002

# Biobank prefix on every pseudonym the uploader mints. Changing it after a run orphans every
# identifier already published.
PSEUDONYM_PREFIX=mmci


# =============================================================================
# DATA CATALOGUE (MOLGENIS EMX2) — uploader stack only
# =============================================================================

CATALOGUE_API_URL=https://data.bbmri.cz
CATALOGUE_SCHEMA=FairGenomesTest

# EMX2 API token. Mint one in the EMX2 UI: account menu -> Manage tokens.
# It needs Editor on CATALOGUE_SCHEMA and nothing more; an admin token reaches every schema on the
# host. Tokens stop parsing if the EMX2 instance is restarted or rekeyed — "Cannot parse token" on
# a request that worked before means mint a new one.
CATALOGUE_TOKEN=

# The single Study row every uploaded Personal points at.
CATALOGUE_STUDY_ID=mmci_biobank
CATALOGUE_STUDY_NAME=MMCI Biobank


# =============================================================================
# RUNNING THE UPLOADER OUTSIDE DOCKER  (dotnet run)
# =============================================================================

# Ignored by the compose files, which set these themselves. Use them when running the sync job on
# the host against databases published on loopback, and point the API URLs at localhost instead of
# host.docker.internal.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data_catalogue_upload
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# No service exists for either yet. Empty means never contacted, which is not the same as
# contacted and failing — the run summary counts them differently.
RADIOLOGY_API_URL=
WSI_API_URL=
