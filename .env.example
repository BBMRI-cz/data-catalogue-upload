# Copy to .env and fill in. .env is git-ignored; never commit a real token.
#
# The same file is used on both servers of a split deployment — each machine fills in its own
# section and leaves the other blank. Docker Compose reads this file twice over: once to substitute
# ${VARIABLES} in the compose file, and again to hand the values to the uploader container.
#
# See docs/deployment.md for which values each server needs.


# =============================================================================
# BIOBANK SERVER  (compose.biobank.yml)
# =============================================================================

# The interface the biobank API listens on. This API has NO authentication and /patients serves
# real patient identifiers, so this must be a private or VPN address that only the uploader's
# machine can reach — never 0.0.0.0 and never a public address. Leave it at loopback until the
# uploader is on another host and you have a firewall rule to match.
BIOBANK_BIND=127.0.0.1

# Where the patient XML export lives on this machine.
BIOBANK_XML_EXPORT_DIR=/home/mou/patient_data


# =============================================================================
# SEQUENCING SERVER  (compose.sequencing.yml) — also runs the uploader
# =============================================================================

# The biobank API as seen from THIS machine. Required: an empty value means "not deployed", so the
# run would quietly upload nobody rather than failing. Use the biobank server's BIOBANK_BIND address.
BIOBANK_API_URL=http://10.0.0.0:8001

# The three read-only source trees on this machine.
SEQUENCING_RUNS_DIR=/muni-sc/OrganisedRuns
SEQUENCING_LIBRARIES_DIR=/muni-sc/Libraries
SEQUENCING_MAPPING_DIR=/home/export/pseudonymization_table

# Only needed if you move the uploader to the other server. Loopback keeps it local.
SEQUENCING_BIND=127.0.0.1


# =============================================================================
# DATA CATALOGUE (MOLGENIS EMX2) — uploader only
# =============================================================================

CATALOGUE_API_URL=https://data.bbmri.cz
CATALOGUE_SCHEMA=FairGenomesTest

# EMX2 API token. Mint one in the EMX2 UI: account menu -> Manage tokens.
# It needs Editor on CATALOGUE_SCHEMA and nothing more; an admin token reaches every schema on the
# host. Tokens stop parsing if the EMX2 instance is restarted or rekeyed — "Cannot parse token" on
# a request that worked before means mint a new one.
CATALOGUE_TOKEN=

# The single Study row every uploaded Personal points at.
CATALOGUE_STUDY_ID=mmci_biobank
CATALOGUE_STUDY_NAME=MMCI Biobank


# =============================================================================
# SINGLE-HOST / LOCAL DEVELOPMENT  (compose.prod.yml, or dotnet run)
# =============================================================================

# Ignored by the split compose files, which set these themselves.
# Leave a source URL empty and that source is never contacted.
SEQUENCING_API_URL=http://localhost:8002
RADIOLOGY_API_URL=
WSI_API_URL=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data_catalogue_upload
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Biobank prefix on every pseudonym the uploader mints. Changing it after a run orphans every
# identifier already published.
PSEUDONYM_PREFIX=mmci
