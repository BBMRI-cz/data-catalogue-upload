# PostgreSQL (used by docker compose and the apps)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_catalogue_upload
POSTGRES_PORT=5432

# --- uploader (apps/uploader): source + catalogue APIs ---
BIOBANK_API_URL=http://localhost:8001
RADIOLOGY_API_URL=http://localhost:8002
SEQUENCING_API_URL=http://localhost:8003
WSI_API_URL=http://localhost:8004
CATALOGUE_API_URL=http://localhost:8000

# --- biobank_api (apps/biobank_api): env prefix BIOBANK_, read by config.Settings ---
# When running on the host against the compose Postgres, use localhost; inside
# compose the service overrides this to point at the `db` host.
BIOBANK_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/biobank_api
BIOBANK_HOST=0.0.0.0
BIOBANK_PORT=8001
BIOBANK_XML_EXPORT_PATH=data/exports
