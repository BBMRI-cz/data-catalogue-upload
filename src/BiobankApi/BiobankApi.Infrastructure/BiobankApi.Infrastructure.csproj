<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>BiobankApi.Infrastructure</RootNamespace>
    <!--
      Mapperly RMG020 (source member not mapped) is expected: the domain samples expose computed
      members (MaterialTypeLabel) and the EF rows carry the PatientId foreign key, neither of which
      has a counterpart on the other side. Unmapped *target* diagnostics stay on to catch real gaps.
    -->
    <NoWarn>$(NoWarn);RMG020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BiobankApi.Application\BiobankApi.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BiobankApi.IntegrationTests" />
    <InternalsVisibleTo Include="BiobankApi.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

</Project>
