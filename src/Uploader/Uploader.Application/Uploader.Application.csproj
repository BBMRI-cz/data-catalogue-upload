<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Uploader.Application</RootNamespace>
    <!--
      Mapperly RMG020 (source member not mapped) is expected: the flat patient/sample DTOs carry
      more than one value object's worth of fields, so each value-object map intentionally leaves
      the others' fields unmapped. Unmapped *target* diagnostics stay on to catch real mistakes.
    -->
    <NoWarn>$(NoWarn);RMG020</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Uploader.Domain\Uploader.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uploader.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ErrorOr" />
    <PackageReference Include="Mediator.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Riok.Mapperly" />
  </ItemGroup>

</Project>
