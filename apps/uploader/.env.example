# uploader (apps/uploader) — copy to apps/uploader/.env

# PostgreSQL (the uploader-db compose service + the host-run job).
# Host runs connect to localhost:${POSTGRES_PORT}; the container is created with these creds.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_catalogue_upload
POSTGRES_PORT=5432

# Source + catalogue APIs the sync job reads from / writes to.
BIOBANK_API_URL=http://localhost:8001
RADIOLOGY_API_URL=http://localhost:8002
SEQUENCING_API_URL=http://localhost:8003
WSI_API_URL=http://localhost:8004
CATALOGUE_API_URL=http://localhost:8000
