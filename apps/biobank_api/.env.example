# biobank_api (apps/biobank_api) — copy to apps/biobank_api/.env

# PostgreSQL (the biobank-db compose service + the connection config.Settings builds).
# Host runs connect to localhost:${POSTGRES_PORT}; inside compose the service overrides
# POSTGRES_HOST/POSTGRES_PORT to reach the biobank-db container.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=biobank_api
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# HTTP server bind address.
BIOBANK_HOST=0.0.0.0
BIOBANK_PORT=8001

# Directory holding the biobank XML export(s) the ingestion parses.
BIOBANK_XML_EXPORT_PATH=data/exports
